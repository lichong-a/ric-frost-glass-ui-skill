{
  "schemaVersion": 1,
  "description": "Explicit demonstration panel annotations. Ranges here constrain this demo and do not redefine the upstream API. Unitless numeric props remain numeric inputs unless their actual contract supplies a unit. Native controlled min/max/step are copied from authored JSX.",
  "components": {
    "cubes": {
      "prop.gridSize": {
        "control": "range",
        "min": 1,
        "max": 40,
        "step": 1,
        "unit": "个/边",
        "description": "以下范围仅限制此演示面板，不改变上游 API。每边立方体数量，源码取整并限制在 1–40。",
        "label": "网格数量",
        "commonPriority": 0
      },
      "prop.gap": {
        "control": "range",
        "min": 0,
        "max": 0.9,
        "step": 0.01,
        "unit": "单元比例",
        "description": "以下范围仅限制此演示面板，不改变上游 API。面宽是 1-gap；是网格单元比例，单位不是 px。",
        "label": "立方体间隙",
        "commonPriority": 0
      },
      "prop.maxAngle": {
        "control": "range",
        "min": 0,
        "max": 75,
        "step": 1,
        "unit": "°",
        "description": "以下范围仅限制此演示面板，不改变上游 API。指针响应允许的最大旋转角度。"
      },
      "prop.radius": {
