  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\nimport { Dialog } from '../../components/Dialog';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessCommandMenuDemo() {\n  const [open,setOpen]=useState(/*__AW_STATE_state.open__*/); const [query,setQuery]=useState(/*__AW_STATE_state.query__*/); const [active,setActive]=useState(0); const [message,setMessage]=useState('尚未选择命令'); const commands=['查看任务','查看资料','查看设置']; const visible=commands.filter(label=>label.includes(query)); function execute(label:string){setMessage('当前入口：'+label);setOpen(false);}\n  return <BusinessDemo title=\"CommandMenu\" description=\"打开命令面板搜索当前页面动作；支持上下键选择、Enter执行与Escape关闭。\">\n    <Button onClick={()=>{setQuery('');setActive(0);setOpen(true);}} /*__AW_PROPS_t0__*/ >打开命令面板</Button><Dialog open={open}  onClose={()=>setOpen(false)} /*__AW_PROPS_t1__*/ ><Field  /*__AW_PROPS_t2__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")}  value={query} aria-controls=\"business-command-results\" onChange={event=>{setQuery(event.target.value);setActive(0);}} onKeyDown={event=>{if(!visible.length)return;if(['ArrowDown','ArrowUp'].includes(event.key)){event.preventDefault();setActive(value=>(value+(event.key==='ArrowDown'?1:-1)+visible.length)%visible.length);}if(event.key==='Enter'){event.preventDefault();execute(visible[active]);}}} /*__AW_PROPS_t3__*/  /></Field><ul id=\"business-command-results\">{visible.map((label,index)=><li key={label}><Button variant={active===index?'primary':'secondary'} onClick={()=>execute(label)} /*__AW_PROPS_t4__*/ >{label}</Button></li>)}</ul>{!visible.length?<p role=\"status\">没有匹配的命令。</p>:null}</Dialog><section data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")} role=\"status\">{message}</section>\n  </BusinessDemo>;\n}\n",
