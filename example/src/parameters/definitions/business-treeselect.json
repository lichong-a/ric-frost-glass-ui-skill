  "usageTemplate": "import ownedStyles0 from '../../components/Button.module.css';\nimport ownedStyles1 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useRef } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Popover } from '../../components/Popover';\nimport { TreeRows } from '../../components/TreeRows';\nimport { workspaceTree } from '../../data';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessTreeSelectDemo() {\n  const [open,setOpen]=useState(/*__AW_STATE_state.open__*/); const [selected,setSelected]=useState<string|null>(/*__AW_STATE_state.selected__*/); const [expanded,setExpanded]=useState(/*__AW_STATE_state.expanded__*/); const anchor=useRef<HTMLButtonElement>(null);\n  let selectedLabel = selected;\n  const remaining = [...workspaceTree];\n  while (remaining.length) {\n    const node = remaining.pop();\n    if (!node) break;\n    if (node.key === selected) { selectedLabel = node.label; break; }\n    remaining.push(...(node.children ?? []));\n  }\n  return <BusinessDemo title=\"TreeSelect\" description=\"在浮层中展开层级并选择节点，选择后关闭，支持清除。\">\n    <div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><button data-ui=\"aw-button\"  className={cn(\"aw-button\")} ref={anchor} aria-haspopup=\"tree\" aria-expanded={open} onClick={()=>setOpen(value=>!value)} /*__AW_PROPS_t0__*/ >{selectedLabel??'选择资料节点'}</button><Button  disabled={!selected} onClick={()=>setSelected(null)} /*__AW_PROPS_t1__*/ >清除</Button></div><Popover open={open} onClose={()=>setOpen(false)} anchorRef={anchor} /*__AW_PROPS_t2__*/ ><TreeRows  selected={selected} expanded={expanded} onSelect={key=>{setSelected(key);setOpen(false);}} onToggle={key=>setExpanded(current=>current.includes(key)?current.filter(value=>value!==key):[...current,key])} /*__AW_PROPS_t3__*/  /></Popover>\n  </BusinessDemo>;\n}\n",
