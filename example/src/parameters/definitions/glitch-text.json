      "key": "t0.speed",
      "name": "speed",
      "label": "切片周期系数",
      "description": "动画、流动或滚动的推进速度；不同效果使用各自的速度尺度。 以下范围仅限制此演示面板，不改变上游 API。两层 CSS 动画周期分别是 speed×3 秒和 speed×2 秒；值越大，循环越慢。",
      "scope": "prop",
      "target": "t0",
      "bindings": [
        {
          "target": "t0",
          "name": "speed"
        }
      ],
      "type": "number",
      "defaultValue": 1,
      "upstreamDefault": "0.5",
      "control": "range",
      "advanced": false,
      "apply": "live",
      "resources": [
        "@asset/restoration/chromatic-bloom.svg",
