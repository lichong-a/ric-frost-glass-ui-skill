        "@asset/restoration/nocturne-orbit.svg",
        "@asset/restoration/prismatic-canopy.svg",
        "@asset/restoration/solar-dunes.svg",
        "@asset/restoration/vermilion-fold.svg"
      ],
      "min": 0.1,
      "max": 2,
      "step": 0.05,
      "unit": "s"
    },
