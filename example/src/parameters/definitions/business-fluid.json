  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { RangeSlider } from '../../components/RangeSlider';\nimport { useBusinessReducedMotion } from '../../motion-preference';\nimport { motion } from 'motion/react';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessFluidDemo() {\n  const reduced=useBusinessReducedMotion(); const [width,setWidth]=useState(/*__AW_STATE_state.width__*/); const [query,setQuery]=useState(/*__AW_STATE_state.query__*/); const [message,setMessage]=useState('等待查询。');\n  return <BusinessDemo title=\"Fluid\" description=\"调整容器宽度，输入与操作按钮随容器伸缩，保持可读布局。\">\n    <Field  label={`容器宽度：${width}%`} /*__AW_PROPS_t0__*/ ><RangeSlider   value={width} onChange={event=>setWidth(Number(event.target.value))} /*__AW_PROPS_t1__*/  /></Field><motion.form animate={{width:`${width}%`}} transition={{duration:reduced?0:0.2}} style={{display:'grid',gap:12}} onSubmit={event=>{event.preventDefault();setMessage(query.trim()?'当前本地查询：'+query.trim():'请输入查询内容。');}}><Field  /*__AW_PROPS_t2__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")}  value={query} onChange={event=>setQuery(event.target.value)} /*__AW_PROPS_t3__*/  /></Field><Button  /*__AW_PROPS_t4__*/ >查询</Button></motion.form><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">{message}</p>\n  </BusinessDemo>;\n}\n",
