  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useId } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Field } from '../../components/Field';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\n// 场景：限制输入字符的体验辅助；仍需要提交校验，不将键盘过滤视为安全边界。\nexport default function KeyFilterDemo() {\n  const id = useId(); const [value, setValue] = useState(/*__AW_STATE_state.value__*/);\n  return <BusinessDemo title=\"KeyFilter · 字符过滤\" description=\"仅保留数字，粘贴与键入使用同一规则。\"><Field  htmlFor={id}  /*__AW_PROPS_t0__*/ ><input className={cn('aw-business-input')} id={id}    value={value} onChange={event => setValue(event.target.value.replace(/\\D/g,'').slice(0,12))} /*__AW_PROPS_t1__*/  /></Field><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">编号：{value || '未填写'}</p></BusinessDemo>;\n}\n",
