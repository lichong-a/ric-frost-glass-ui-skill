  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { SpringCheckbox } from '../../components/SpringCheckbox';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Dialog } from '../../components/Dialog';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessDrawerDemo() {\n  const [open,setOpen]=useState(/*__AW_STATE_state.open__*/); const [notify,setNotify]=useState(/*__AW_STATE_state.notify__*/);\n  const [side,setSide]=useState<'right'|'left'|'top'|'bottom'>('right');\n  const directions = [{side:'right',label:'右侧'}, {side:'left',label:'左侧'}, {side:'top',label:'上方'}, {side:'bottom',label:'下方'}] as const;\n  return <BusinessDemo title=\"Drawer\" description=\"从上下左右打开同一任务抽屉，勾选本地选项后关闭；切换方向或再次打开保留选择。\">\n    <div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")} role=\"group\" aria-label=\"抽屉方向\">{directions.map(direction=><Button key={direction.side}  onClick={()=>{setSide(direction.side);setOpen(true);}} /*__AW_PROPS_t0__*/ >{direction.label}抽屉</Button>)}</div><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">本地提醒：{notify?'开启':'关闭'}</p><Dialog open={open} side={side}  onClose={()=>setOpen(false)} /*__AW_PROPS_t1__*/ ><label data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><SpringCheckbox checked={notify} onChange={event=>setNotify(event.target.checked)} />完成后在界面显示提醒</label><Button onClick={()=>setOpen(false)} /*__AW_PROPS_t3__*/ >完成</Button></Dialog>\n  </BusinessDemo>;\n}\n",
