  "usageTemplate": "// Authored integration demo; implementation is installed from the pinned official source.\nimport Component from '../../../.upstream/src/ts-default/Components/ElasticSlider/ElasticSlider';\nimport { palette } from '../../shared/demo-support';\nimport { ChakraProvider, defaultSystem } from \"@chakra-ui/react\";\nimport { Volume1, Volume2 } from \"lucide-react\";\n// 使用ChakraProvider(defaultSystem)满足上游Icon上下文；此组件仅提供内部值，没有onChange Props，不伪造受控接口。\n\nexport default function ElasticSliderDemo() {\n\n  return (\n    <div className=\"aw-demo-stage\" style={{ width: '100%', minHeight: 340, position: 'relative', display: 'grid', placeItems: 'center', padding: 24, color: palette.ink }}>\n      <ChakraProvider value={defaultSystem}><style>{`.slider-container { color: #52604e; }.slider-range { background-color: #52604e; }.slider-track { background-color: #c3c8b8; }.value-indicator,.icon { color: #5c6259; }`}</style><div style={{ width: '100%', minHeight: 300, display: 'grid', placeItems: 'center', color: palette.ink }}><Component      leftIcon={<Volume1 size={22} />} rightIcon={<Volume2 size={22} />} /*__AW_PROPS_t0__*/  /><p style={{ fontSize: 14, color: palette.muted }}>拖动滑块，观察两端弹性与组件内置数值</p></div></ChakraProvider>\n    </div>\n  );\n}\n",
