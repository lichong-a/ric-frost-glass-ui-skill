  "usageTemplate": "import ownedStyles0 from '../../components/Button.module.css';\nimport ownedStyles1 from '../../components/DemoLayout.module.css';\nimport ownedStyles2 from '../../components/Input.module.css';\nimport ownedStyles3 from '../../components/SelectOptions.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useId, useEffect } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\nimport { AnimatePresence } from 'motion/react';\nimport { DropdownSurface } from '../../components/DropdownSurface';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1,...ownedStyles2,...ownedStyles3};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\n// 场景：从较多候选项中边输入边搜索，支持键盘选择与清空。\nexport default function AutoCompleteDemo() {\n  const options = ['项目工作台', '智能体管理', '技能目录', '知识库', '工具连接', '运行记录', '团队空间'];\n  const id = useId(); const [query, setQuery] = useState(/*__AW_STATE_state.query__*/); const [selected, setSelected] = useState('');\n  const [open, setOpen] = useState(false); const [active, setActive] = useState(0);\n  const matches = options.filter(item => item.includes(query.trim()));\n  useEffect(() => {\n    if (open) document.getElementById(`${id}-option-${active}`)?.scrollIntoView({ block: 'nearest' });\n  }, [id, open, active, matches.length]);\n  function choose(value: string) { setQuery(value); setSelected(value); setOpen(false); }\n  return <BusinessDemo title=\"AutoComplete · 自动补全\" description=\"从较多候选项中边输入边搜索，支持方向键、Enter 和 Escape。\"><Field  htmlFor={id} /*__AW_PROPS_t0__*/ ><div data-ui=\"aw-business-combo\" className={cn(\"aw-business-combo\")} onBlur={event => { if (!event.currentTarget.contains(event.relatedTarget)) setOpen(false); }}><input className={cn('aw-business-input')} id={id} role=\"combobox\" aria-autocomplete=\"list\" aria-expanded={open} aria-controls={`${id}-options`} aria-activedescendant={open && matches[active] ? `${id}-option-${active}` : undefined} value={query}  onFocus={() => setOpen(true)} onChange={event => { setQuery(event.target.value); setSelected(''); setActive(0); setOpen(true); }} onKeyDown={event => { if (['ArrowDown','ArrowUp'].includes(event.key)) { event.preventDefault(); setOpen(true); setActive(value => matches.length ? (value + (event.key === 'ArrowDown' ? 1 : -1) + matches.length) % matches.length : 0); } else if (event.key === 'Enter' && open && matches[active]) { event.preventDefault(); choose(matches[active]); } else if (event.key === 'Escape') setOpen(false); }} /*__AW_PROPS_t1__*/  /><AnimatePresence>{open ? <DropdownSurface data-ui=\"aw-business-combo-list\" key=\"suggestions\" className={cn(\"aw-business-combo-list\")}><ul data-ui=\"aw-business-options\" id={`${id}-options`} role=\"listbox\" className={cn(\"aw-business-options\")}>{matches.length ? matches.map((item,index) => <li key={item} id={`${id}-option-${index}`} role=\"option\" aria-selected={active === index}><button className={cn('aw-business-button-feedback')}   onPointerDown={event => event.preventDefault()} onClick={() => choose(item)} /*__AW_PROPS_t3__*/ >{item}</button></li>) : <li data-ui=\"aw-business-empty\" className={cn(\"aw-business-empty\")}>没有匹配的入口</li>}</ul></DropdownSurface> : null}</AnimatePresence></div></Field><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><Button  onClick={() => { setQuery(''); setSelected(''); setOpen(false); }} /*__AW_PROPS_t4__*/ >清空</Button><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">{selected ? `已选择：${selected}` : '尚未选择入口'}</p></div></BusinessDemo>;\n}\n",
