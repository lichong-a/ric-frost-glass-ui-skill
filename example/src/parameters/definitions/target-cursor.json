  "inherited": [],
  "usageTemplate": "// Authored integration demo; implementation is installed from the pinned official source.\nimport Component from '../../../.upstream/src/ts-default/Animations/TargetCursor/TargetCursor';\nimport { palette } from '../../shared/demo-support';\nimport { useRef, useState } from \"react\";\n// 光标括号只追踪本预览内的目标；按钮是真实可点击计数。\n\nexport default function TargetCursorDemo() {\n  const scopeRef = useRef<HTMLDivElement>(null!); const [count, setCount] = useState(0);\n  return (\n    <div className=\"aw-demo-stage\" style={{ width: '100%', height: 360, position: 'relative', overflow: 'hidden', color: palette.ink }}>\n      <div ref={scopeRef} style={{ position: 'relative', minHeight: 320, display: 'grid', placeItems: 'center', gap: 20, padding: 24 }}><Component container={scopeRef}          /*__AW_PROPS_t0__*/  /><button className=\"aw-button aw-cursor-target\" data-variant=\"primary\"  data-cursor-label=\"运行\" onClick={() => setCount(value => value + 1)} /*__AW_PROPS_t1__*/ >运行 {count} 次</button><div className=\"aw-cursor-target\" data-cursor-label=\"查看\" style={{ padding: 24, borderRadius: 20, background: palette.sage, color: palette.ink }}>将指针移入此目标</div></div>\n    </div>\n  );\n}\n",
