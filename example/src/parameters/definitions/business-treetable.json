  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { workspaceTree } from '../../data';\nimport { type TreeItem } from '../../data';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessTreeTableDemo() {\n  const [expanded,setExpanded]=useState(['workspace']); const [selected,setSelected]=useState<string|null>(null); const rows: {key:string;label:string;depth:number;children?:TreeItem[]}[]=[]; function visit(nodes:TreeItem[],depth:number){nodes.forEach(node=>{rows.push({...node,depth});if(node.children&&expanded.includes(node.key))visit(node.children,depth+1);});} visit(workspaceTree,0);\n  return <BusinessDemo title=\"TreeTable\" description=\"将层级资料展开为表格，查看子项数量并选择节点。\">\n    <table data-ui=\"aw-business-table\" className={cn(\"aw-business-table\")}><thead><tr><th scope=\"col\">资料节点</th><th scope=\"col\">子项</th><th scope=\"col\">操作</th></tr></thead><tbody>{rows.map(node=><tr key={node.key}><td style={{paddingLeft:12+node.depth*20}}>{node.children?<Button  aria-label={(expanded.includes(node.key)?'收起':'展开')+node.label} onClick={()=>setExpanded(current=>current.includes(node.key)?current.filter(key=>key!==node.key):[...current,node.key])} /*__AW_PROPS_t0__*/ >{expanded.includes(node.key)?'−':'+'}</Button>:null} {node.label}</td><td>{node.children?.length??0}</td><td><Button  onClick={()=>setSelected(node.key)} /*__AW_PROPS_t1__*/ >选择</Button></td></tr>)}</tbody></table><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">{selected?'已选择：'+selected:'请选择资料节点。'}</p>\n  </BusinessDemo>;\n}\n",
