  "usageTemplate": "// Authored integration demo; implementation is installed from the pinned official source.\nimport Component, { ScrollStackItem } from '../../../.upstream/src/ts-default/Components/ScrollStack/ScrollStack';\nimport { palette } from '../../shared/demo-support';\nimport { useState } from \"react\";\n// 采用真实ScrollStackItem具名子组件；局部滚动有足够距离完成堆叠。\n\nexport default function ScrollStackDemo() {\n  const [status, setStatus] = useState(\"在此卡片区域内滚动\");\n\n  return (\n    <div className=\"aw-demo-stage\" style={{ width: '100%', height: 480, position: 'relative', overflow: 'hidden' }}>\n      <div style={{ width: '100%', height: '100%' }}><div style={{ height: 430, width: '100%', position: 'relative' }}><Component\n\n\nonStackComplete={() => setStatus('三张卡片已完成堆叠')} /*__AW_PROPS_t0__*/ >{['收集上下文', '生成执行计划', '交付结果'].map((title, index) => <ScrollStackItem key={title} style={{ background: [palette.ivory, palette.canvas, palette.sage][index], color: palette.ink, borderRadius: 20, minHeight: 200 }} /*__AW_PROPS_t1__*/ ><h3>{index + 1} · {title}</h3><p>继续在卡片区域向下滚动，查看顺序叠放。</p></ScrollStackItem>)}</Component></div><p role=\"status\" aria-live=\"polite\" style={{ margin: '12px 20px', fontSize: 14, color: palette.muted }}>{status}</p></div>\n    </div>\n  );\n}\n",
