  "usageTemplate": "// Authored integration demo; implementation is installed from the pinned official source.\nimport Component from '../../../.upstream/src/ts-default/Components/CardNav/CardNav';\nimport { palette } from '../../shared/demo-support';\nimport { useState } from \"react\";\n// 保留真实卡片导航展开与键盘菜单按钮，链接在本示例中更新结果提示。\n\nexport default function CardNavDemo() {\n  const [status, setStatus] = useState('点击菜单按钮展开三个导航卡片');\n  return (\n    <div className=\"aw-demo-stage\" style={{ width: '100%', height: 400, position: 'relative', overflow: 'hidden', color: palette.ink }}>\n      <div style={{ position: 'relative', width: '100%', maxWidth: 800, height: 420 }} onClickCapture={event => { const target = event.target as Element; const link = target.closest('a'); if (link) { event.preventDefault(); setStatus('已选择：' + link.textContent); } else if (target.closest('.card-nav-cta-button')) { setStatus('开始使用按钮已点击'); } }}><Component         /*__AW_PROPS_t0__*/  /><p role=\"status\" aria-live=\"polite\" style={{ position: 'absolute', left: 24, bottom: 12, color: palette.muted }}>{status}</p></div>\n    </div>\n  );\n}\n",
