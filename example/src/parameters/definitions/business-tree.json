  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { TreeRows } from '../../components/TreeRows';\n\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessTreeDemo() {\n  const [selected,setSelected]=useState<string|null>(/*__AW_STATE_state.selected__*/); const [expanded,setExpanded]=useState(/*__AW_STATE_state.expanded__*/);\n  return <BusinessDemo title=\"Tree\" description=\"展开工作空间层级并选择单个节点，支持左右方向键展开或收起。\">\n    <TreeRows  selected={selected} expanded={expanded} onSelect={setSelected} onToggle={key=>setExpanded(current=>current.includes(key)?current.filter(value=>value!==key):[...current,key])} /*__AW_PROPS_t0__*/  /><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">{selected?'已选择：'+selected:'尚未选择节点。'}</p><Button  onClick={()=>{setSelected(null);setExpanded([]);}} /*__AW_PROPS_t1__*/ >收起并清除选择</Button>\n  </BusinessDemo>;\n}\n",
