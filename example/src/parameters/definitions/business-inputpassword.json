  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useId } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\n// 场景：敏感文本输入，提供显隐切换与本地强度提示，不记录或持久化值。\nexport default function InputPasswordDemo() {\n  const id = useId(); const [value, setValue] = useState(/*__AW_STATE_state.value__*/); const [visible, setVisible] = useState(/*__AW_STATE_state.visible__*/); const strength = [value.length >= 8,/[A-Z]/.test(value),/[0-9]/.test(value),/[^a-zA-Z0-9]/.test(value)].filter(Boolean).length;\n  return <BusinessDemo title=\"InputPassword · 密码输入\" description=\"可切换显隐，强度提示辅助理解规则。\"><Field  htmlFor={id} /*__AW_PROPS_t0__*/ ><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><input className={cn('aw-business-input')} id={id}  type={visible ? 'text' : 'password'}   value={value} onChange={event => setValue(event.target.value)} /*__AW_PROPS_t1__*/  /><Button  aria-pressed={visible} onClick={() => setVisible(current => !current)} /*__AW_PROPS_t2__*/ >{visible ? '隐藏' : '显示'}</Button></div></Field><meter   value={strength}  /*__AW_PROPS_t3__*/  /><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">本地强度：{['未输入','较弱','一般','较好','较强'][value ? strength : 0]}</p></BusinessDemo>;\n}\n",
