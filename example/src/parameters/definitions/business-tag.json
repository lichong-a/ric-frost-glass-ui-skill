  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessTagDemo() {\n  const [status,setStatus]=useState('全部'); const records=[{id:1,title:'资料整理',status:'进行中'},{id:2,title:'合同校对',status:'已完成'},{id:3,title:'客户跟进',status:'待开始'}];\n  return <BusinessDemo title=\"Tag\" description=\"筛选任务状态，标签与本地记录列表保持一致。\">\n    <div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}>{['全部','待开始','进行中','已完成'].map(label=><Button key={label}  aria-pressed={status===label} onClick={()=>setStatus(label)} /*__AW_PROPS_t0__*/ >{label}</Button>)}</div><ul>{records.filter(item=>status==='全部'||item.status===status).map(item=><li data-ui=\"aw-business-row\" key={item.id} className={cn(\"aw-business-row\")}><span>{item.title}</span><span data-ui=\"aw-business-tag\" className={cn(\"aw-business-tag\")} data-status={item.status}>{item.status}</span></li>)}</ul>\n  </BusinessDemo>;\n}\n",
