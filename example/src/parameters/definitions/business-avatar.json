  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\n\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessAvatarDemo() {\n  const [name,setName]=useState(/*__AW_STATE_state.name__*/); const [photo,setPhoto]=useState(false);\n  return <BusinessDemo title=\"Avatar\" description=\"在姓名缩写与本地头像之间切换，编辑显示名称会同步缩写。\">\n    <Field  /*__AW_PROPS_t0__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")} value={name} onChange={event=>setName(event.target.value)} /></Field><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><span role=\"img\" aria-label={name?name+'的头像':'未命名头像'} style={{display:'grid',placeItems:'center',width:64,height:64,borderRadius:'50%',overflow:'hidden',background:'var(--aw-palette-sage)',fontSize:24}}>{photo?<img    /*__AW_PROPS_t2__*/  />:name.slice(0,2)||'?'}</span><Button  onClick={()=>setPhoto(value=>!value)} /*__AW_PROPS_t3__*/ >{photo?'显示姓名缩写':'使用本地图片'}</Button></div>\n  </BusinessDemo>;\n}\n",
