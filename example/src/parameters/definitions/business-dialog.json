  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\nimport { Dialog } from '../../components/Dialog';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessDialogDemo() {\n  const [open,setOpen]=useState(/*__AW_STATE_state.open__*/); const [saved,setSaved]=useState('资料整理'); const [draft,setDraft]=useState(saved);\n  return <BusinessDemo title=\"Dialog\" description=\"在模态弹窗中编辑本地任务名称，确认后才更新已保存值。\">\n    <Button onClick={()=>{setDraft(saved);setOpen(true);}} /*__AW_PROPS_t0__*/ >编辑任务</Button><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">已保存名称：{saved}</p><Dialog open={open}  onClose={()=>setOpen(false)} /*__AW_PROPS_t1__*/ ><Field  /*__AW_PROPS_t2__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")} value={draft} onChange={event=>setDraft(event.target.value)} /></Field><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><Button disabled={!draft.trim()} onClick={()=>{setSaved(draft.trim());setOpen(false);}} /*__AW_PROPS_t4__*/ >确认</Button><Button  onClick={()=>setOpen(false)} /*__AW_PROPS_t5__*/ >取消</Button></div></Dialog>\n  </BusinessDemo>;\n}\n",
