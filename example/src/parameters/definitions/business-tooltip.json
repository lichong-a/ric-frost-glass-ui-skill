  "usageTemplate": "import ownedStyles0 from '../../components/Button.module.css';\nimport ownedStyles1 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useId } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessTooltipDemo() {\n  const [visible,setVisible]=useState(false); const tooltipId=useId();\n  return <BusinessDemo title=\"Tooltip\" description=\"悬停或键盘聚焦图标时显示说明，离开或按Escape后隐藏。\">\n    <div style={{position:'relative',width:'fit-content'}}><button data-ui=\"aw-button\"  className={cn(\"aw-button\")}  aria-describedby={visible?tooltipId:undefined} onMouseEnter={()=>setVisible(true)} onMouseLeave={()=>setVisible(false)} onFocus={()=>setVisible(true)} onBlur={()=>setVisible(false)} onKeyDown={event=>{if(event.key==='Escape')setVisible(false);}} /*__AW_PROPS_t0__*/ >?</button>{visible?<div data-ui=\"aw-business-item\" id={tooltipId} role=\"tooltip\" className={cn(\"aw-business-item\")} style={{position:'absolute',top:'calc(100% + 8px)',left:0,width:220,zIndex:2}}>这里查看当前操作的说明。</div>:null}</div><p>使用 Tab 聚焦帮助按钮也能阅读提示。</p>\n  </BusinessDemo>;\n}\n",
