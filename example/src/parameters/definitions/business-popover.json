  "usageTemplate": "import ownedStyles0 from '../../components/Button.module.css';\nimport ownedStyles1 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useRef } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Popover } from '../../components/Popover';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessPopoverDemo() {\n  const [open,setOpen]=useState(/*__AW_STATE_state.open__*/); const [choice,setChoice]=useState('未选择'); const anchor=useRef<HTMLButtonElement>(null);\n  return <BusinessDemo title=\"Popover\" description=\"围绕触发按钮定位浮层，选择内容后关闭，外点和Escape也可关闭。\">\n    <button data-ui=\"aw-button\"  className={cn(\"aw-button\")} ref={anchor} aria-expanded={open} onClick={()=>setOpen(value=>!value)} /*__AW_PROPS_t0__*/ >选择视图</button><Popover open={open} onClose={()=>setOpen(false)} anchorRef={anchor} /*__AW_PROPS_t1__*/ ><div data-ui=\"aw-business-list\" className={cn(\"aw-business-list\")}>{['列表','看板','日历'].map(label=><Button key={label}  onClick={()=>{setChoice(label);setOpen(false);}} /*__AW_PROPS_t2__*/ >{label}</Button>)}</div></Popover><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">当前视图：{choice}</p>\n  </BusinessDemo>;\n}\n",
