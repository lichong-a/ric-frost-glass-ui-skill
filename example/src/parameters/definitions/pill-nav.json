  "usageTemplate": "// Authored integration demo; implementation is installed from the pinned official source.\nimport Component from '../../../.upstream/src/ts-default/Components/PillNav/PillNav';\nimport { palette } from '../../shared/demo-support';\nimport { MemoryRouter, useLocation } from \"react-router-dom\";\n// MemoryRouter提供真实路由上下文；activeHref来自useLocation，不使用固定选中项。\n\nexport default function PillNavDemo() {\n  function RoutedExample() { const location = useLocation(); return <div style={{ padding: 28, color: palette.ink }}><Component    activeHref={location.pathname}      /*__AW_PROPS_t0__*/  /><p role=\"status\" style={{ paddingTop: 190, color: palette.muted }}>当前示例路由：{location.pathname}</p></div>; }\n  return (\n    <div className=\"aw-demo-stage\" style={{ width: '100%', height: 400, position: 'relative', overflow: 'hidden', color: palette.ink }}>\n      <MemoryRouter initialEntries={[\"/overview\"]}><RoutedExample /></MemoryRouter>\n    </div>\n  );\n}\n",
