  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/ToggleSwitch.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useId } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\n// 场景：立即生效的二元设置；危险或有外部副作用的设置仍需要业务确认。\nexport default function ToggleSwitchDemo() {\n  const id = useId(); const [enabled, setEnabled] = useState(/*__AW_STATE_state.enabled__*/);\n  return <BusinessDemo title=\"ToggleSwitch · 设置开关\" description=\"开关表示当前本地偏好，切换立即更新显示。\"><label data-ui=\"aw-business-choice\" className={cn(\"aw-business-choice\")} htmlFor={id}><input data-ui=\"aw-business-switch\" id={id} className={cn(\"aw-business-switch\")}  role=\"switch\" checked={enabled} onChange={event => setEnabled(event.target.checked)} /*__AW_PROPS_t0__*/  />显示详细摘要</label><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">摘要：{enabled ? '详细' : '简洁'}</p></BusinessDemo>;\n}\n",
