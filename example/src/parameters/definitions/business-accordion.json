  "usageTemplate": "import ownedStyles0 from '../../components/Accordion.module.css';\nimport ownedStyles1 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useId, useState } from 'react';\nimport { motion } from 'motion/react';\nimport { ChevronDown } from 'lucide-react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { AnimatedCollapse } from '../../components/AnimatedCollapse';\nimport { controlSpring } from '../../motion-preference';\nimport { useBusinessReducedMotion } from '../../motion-preference';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessAccordionDemo() {\n  const [open, setOpen] = useState<string[]>(/*__AW_STATE_state.open__*/);\n  const id = useId();\n  const reduced = useBusinessReducedMotion();\n  return <BusinessDemo title=\"Accordion\" description=\"章节以自然高度过渡展开或收起，标题箭头弹性旋转。\">\n    {['范围', '权限', '交付'].map((label, index) => <section data-ui=\"aw-business-item\" key={label} className={cn(\"aw-business-item aw-business-accordion-item\")}>\n      <h3><button data-ui=\"aw-business-accordion-trigger\"  className={cn(\"aw-business-accordion-trigger\")} id={`${id}-trigger-${index}`} aria-expanded={open.includes(label)} aria-controls={`${id}-content-${index}`} onClick={() => setOpen(current => current.includes(label) ? current.filter(item => item !== label) : [...current, label])} /*__AW_PROPS_t0__*/ >{label}<motion.span aria-hidden=\"true\" animate={{ rotate: open.includes(label) ? 180 : 0 }} transition={reduced ? { duration: 0 } : controlSpring}><ChevronDown size={18} /></motion.span></button></h3>\n      <AnimatedCollapse id={`${id}-content-${index}`} open={open.includes(label)}><div role=\"region\" aria-labelledby={`${id}-trigger-${index}`}><p>{label === '范围' ? '仅处理当前示例中的本地资料。' : label === '权限' ? '对外写入应由业务服务校验权限。' : '任务结果保持可读，可逐项确认。'}</p></div></AnimatedCollapse>\n    </section>)}<Button  onClick={() => setOpen([])} /*__AW_PROPS_t2__*/ >全部收起</Button>\n  </BusinessDemo>;\n}\n",
