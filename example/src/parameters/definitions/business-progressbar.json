  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessProgressBarDemo() {\n  const [progress,setProgress]=useState(/*__AW_STATE_state.progress__*/);\n  return <BusinessDemo title=\"ProgressBar\" description=\"本地步骤完成度由按钮驱动，终值限制在100%，可重置。\">\n    <label>资料整理完成度<progress  value={progress}  /*__AW_PROPS_t0__*/ >{progress}%</progress></label><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">{progress}% {progress===100?'已完成':'处理中'}</p><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><Button disabled={progress===100} onClick={()=>setProgress(value=>Math.min(100,value+20))} /*__AW_PROPS_t1__*/ >完成下一步</Button><Button  onClick={()=>setProgress(0)} /*__AW_PROPS_t2__*/ >重置</Button></div>\n  </BusinessDemo>;\n}\n",
