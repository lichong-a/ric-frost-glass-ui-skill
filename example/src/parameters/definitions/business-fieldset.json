  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { SpringCheckbox } from '../../components/SpringCheckbox';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Field } from '../../components/Field';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessFieldsetDemo() {\n  const [enabled,setEnabled]=useState(/*__AW_STATE_state.enabled__*/); const [name,setName]=useState(/*__AW_STATE_state.name__*/);\n  return <BusinessDemo title=\"Fieldset\" description=\"用原生字段组组织联系信息；启用开关控制组内输入。\">\n    <label data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><SpringCheckbox checked={enabled} onChange={event=>setEnabled(event.target.checked)} />允许编辑</label><fieldset data-ui=\"aw-business-item\" disabled={!enabled} className={cn(\"aw-business-item aw-business-animated-fieldset\")}><legend>联系资料</legend><Field  /*__AW_PROPS_t1__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")} value={name} onChange={event=>setName(event.target.value)} /></Field></fieldset><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">当前名称：{name||'未填写'}；{enabled?'可编辑':'已禁用'}。</p>\n  </BusinessDemo>;\n}\n",
