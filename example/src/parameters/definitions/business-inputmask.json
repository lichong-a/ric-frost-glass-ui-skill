  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useId } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Field } from '../../components/Field';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\n// 场景：录入固定格式的标识符；掩码辅助输入，不替代完整格式与服务端校验。\nexport default function InputMaskDemo() {\n  const id = useId(); const [digits, setDigits] = useState(''); const value = [digits.slice(0,3),digits.slice(3,7),digits.slice(7,11)].filter(Boolean).join(' ');\n  return <BusinessDemo title=\"InputMask · 格式输入\" description=\"手机号格式辅助；保存纯数字，展示按分组排版。\"><Field  htmlFor={id}  /*__AW_PROPS_t0__*/ ><input className={cn('aw-business-input')} id={id}    value={value}  onChange={event => setDigits(event.target.value.replace(/\\D/g,'').slice(0,11))} /*__AW_PROPS_t1__*/  /></Field><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">原始值：{digits || '空'} · {digits.length === 11 ? '格式完整' : `已录入 ${digits.length}/11 位`}</p></BusinessDemo>;\n}\n",
