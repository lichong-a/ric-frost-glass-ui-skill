  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\nimport { workItems } from '../../data';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessPickListDemo() {\n  const [chosen,setChosen]=useState<string[]>([]); const [query,setQuery]=useState(/*__AW_STATE_state.query__*/);\n  return <BusinessDemo title=\"PickList\" description=\"在候选任务与已选任务之间移动条目，保留每项唯一身份。\">\n    <Field  /*__AW_PROPS_t0__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")} value={query} onChange={event=>setQuery(event.target.value)} /></Field><div data-ui=\"aw-business-grid\" className={cn(\"aw-business-grid\")}><section data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")}><h3>候选任务</h3>{workItems.filter(item=>!chosen.includes(item.id)&&item.title.includes(query)).map(item=><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")} key={item.id}><span>{item.title}</span><Button aria-label={'加入'+item.title} onClick={()=>setChosen(current=>[...current,item.id])} /*__AW_PROPS_t2__*/ >加入 →</Button></div>)}{!workItems.some(item=>!chosen.includes(item.id)&&item.title.includes(query))?<p>没有候选项。</p>:null}</section><section data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")}><h3>已选任务</h3>{chosen.map(id=>{const item=workItems.find(item=>item.id===id)!;return <div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")} key={id}><span>{item.title}</span><Button  aria-label={'移除'+item.title} onClick={()=>setChosen(current=>current.filter(value=>value!==id))} /*__AW_PROPS_t3__*/ >← 移除</Button></div>;})}{!chosen.length?<p>尚未选择任务。</p>:null}</section></div><Button  disabled={!chosen.length} onClick={()=>setChosen([])} /*__AW_PROPS_t4__*/ >移除全部</Button>\n  </BusinessDemo>;\n}\n",
