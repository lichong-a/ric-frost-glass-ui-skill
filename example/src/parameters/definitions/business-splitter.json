  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Splitter.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useRef } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessSplitterDemo() {\n  const [ratio,setRatio]=useState(/*__AW_STATE_state.ratio__*/); const container=useRef<HTMLDivElement>(null); const dragging=useRef(false); const [isDragging,setIsDragging]=useState(false);\n  return <BusinessDemo title=\"Splitter\" description=\"拖动分隔条或用键盘调整两个工作区的宽度，限制在20%到80%。\">\n    <div data-ui=\"aw-business-splitter\" ref={container} className={cn(\"aw-business-splitter\")} data-dragging={isDragging} style={{display:'grid',gridTemplateColumns:`minmax(0, ${ratio}fr) 16px minmax(0, ${100-ratio}fr)`,minHeight:180}}><section data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")}><h3>资料</h3><p>左侧工作区</p></section><div role=\"separator\"  aria-orientation=\"vertical\" aria-valuemin={20} aria-valuemax={80} aria-valuenow={ratio}   onPointerDown={event=>{dragging.current=true;setIsDragging(true);event.currentTarget.setPointerCapture(event.pointerId);}} onPointerMove={event=>{if(!dragging.current||!container.current)return;const box=container.current.getBoundingClientRect();setRatio(Math.min(80,Math.max(20,Math.round((event.clientX-box.left)/box.width*100))));}} onPointerUp={()=>{dragging.current=false;setIsDragging(false);}} onPointerCancel={()=>{dragging.current=false;setIsDragging(false);}} onLostPointerCapture={()=>{dragging.current=false;setIsDragging(false);}} onKeyDown={event=>{if(['ArrowLeft','ArrowRight'].includes(event.key)){event.preventDefault();setRatio(value=>Math.min(80,Math.max(20,value+(event.key==='ArrowLeft'?-5:5))));}}} /*__AW_PROPS_t0__*/  /><section data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")}><h3>结果</h3><p>右侧工作区</p></section></div><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">左侧 {ratio}% · 右侧 {100-ratio}%</p>\n  </BusinessDemo>;\n}\n",
