  "usageTemplate": "// Authored integration demo; implementation is installed from the pinned official source.\nimport Component from '../../../.upstream/src/ts-default/Animations/ClickSpark/ClickSpark';\nimport { palette } from '../../shared/demo-support';\nimport { useState } from \"react\";\n// 真实点击坐标产生粒子火花，按钮计数验证交互没有被覆盖层吞掉。\n// 此演示使用Canvas；确保容器拥有非零宽高。\n\nexport default function ClickSparkDemo() {\n  const [count, setCount] = useState(0);\n  return (\n    <div className=\"aw-demo-stage\" style={{ width: '100%', height: 360, position: 'relative', overflow: 'hidden', color: palette.ink }}>\n      <Component\n   /*__AW_PROPS_t0__*/ ><div style={{ width: \"100%\", minHeight: 320, display: \"grid\", placeItems: \"center\" }}><button className=\"aw-button\" data-variant=\"primary\"  onClick={() => setCount(value => value + 1)} /*__AW_PROPS_t1__*/ >点击产生火花 · {count}</button></div></Component>\n    </div>\n  );\n}\n",
