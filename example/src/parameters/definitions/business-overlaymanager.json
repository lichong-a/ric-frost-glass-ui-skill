  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Dialog } from '../../components/Dialog';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessOverlayManagerDemo() {\n  const [stack,setStack]=useState<string[]>(/*__AW_STATE_state.stack__*/);\n  return <BusinessDemo title=\"OverlayManager\" description=\"两个原生模态弹层按打开顺序形成有限栈，浏览器管理层级、焦点与Escape。\">\n    <Button onClick={()=>setStack(['editor'])} /*__AW_PROPS_t0__*/ >打开第一层</Button><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">当前弹层数：{stack.length}</p><Dialog open={stack.includes('editor')}  onClose={()=>setStack([])} /*__AW_PROPS_t1__*/ ><p>确认动作会打开第二层，关闭第二层后回到这里。</p><Button onClick={()=>setStack(['editor','confirm'])} /*__AW_PROPS_t2__*/ >打开确认层</Button></Dialog><Dialog open={stack.includes('confirm')}  onClose={()=>setStack(['editor'])} /*__AW_PROPS_t3__*/ ><p>此示例只管理当前页面的弹层。</p><Button onClick={()=>setStack(['editor'])} /*__AW_PROPS_t4__*/ >返回第一层</Button><Button  onClick={()=>setStack([])} /*__AW_PROPS_t5__*/ >关闭全部</Button></Dialog>\n  </BusinessDemo>;\n}\n",
