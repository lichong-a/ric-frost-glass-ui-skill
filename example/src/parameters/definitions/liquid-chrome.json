  "usageTemplate": "import Component from '../../../.upstream/src/ts-default/Backgrounds/LiquidChrome/LiquidChrome';\nimport { palette } from '../../shared/demo-support';\n\nfunction toRgb(hex: string): [number, number, number] {\n  return [\n    Number.parseInt(hex.slice(1, 3), 16) / 255,\n    Number.parseInt(hex.slice(3, 5), 16) / 255,\n    Number.parseInt(hex.slice(5, 7), 16) / 255,\n  ];\n}\n\n/** Agent Wan natural-tone preset for the real Liquid Chrome component. */\nexport default function LiquidChromeDemo() {\n  return (\n    <div className=\"aw-demo-stage\" data-layout=\"full\" data-canvas=\"dark\">\n      <div style={{ width: '100%', height: 560, position: 'relative' }}>\n        <Component\n          baseColor={toRgb(palette.primary)}\n\n\n\n\n           /*__AW_PROPS_t0__*/\n        />\n      </div>\n    </div>\n  );\n}\n",
