  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useId, useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Field } from '../../components/Field';\nimport { DatePicker } from '../../components/DatePicker';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function DatePickerDemo() {\n  const id = useId();\n  const [date, setDate] = useState(/*__AW_STATE_state.date__*/);\n  const [end, setEnd] = useState(/*__AW_STATE_state.end__*/);\n  return <BusinessDemo title=\"DatePicker · 日期选择\" description=\"定制自然色日历，支持月份过渡、键盘选日和起止区间；日期保存为 YYYY-MM-DD。\">\n    <div data-ui=\"aw-business-grid\" className={cn(\"aw-business-grid\")}>\n      <Field  htmlFor={id} /*__AW_PROPS_t0__*/ ><DatePicker id={id}  value={date} rangeStart={date} rangeEnd={end} onChange={value => { setDate(value); if (value && end && value > end) setEnd(value); }} /*__AW_PROPS_t1__*/  /></Field>\n      <Field  htmlFor={`${id}-end`} /*__AW_PROPS_t2__*/ ><DatePicker id={`${id}-end`}  value={end} min={date || undefined} rangeStart={date} rangeEnd={end} onChange={setEnd} /*__AW_PROPS_t3__*/  /></Field>\n    </div><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">区间：{date || '未选'} 至 {end || '未选'}</p>\n    <p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")}>方向键移动日期 · Page Up / Down 切换月份 · Enter 选择 · Esc 关闭</p>\n  </BusinessDemo>;\n}\n",
