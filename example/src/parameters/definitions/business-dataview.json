  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\nimport { workItems } from '../../data';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessDataViewDemo() {\n  const [grid,setGrid]=useState(false); const [query,setQuery]=useState(/*__AW_STATE_state.query__*/); const visible=workItems.filter(item=>item.title.includes(query));\n  return <BusinessDemo title=\"DataView\" description=\"同一组工作项切换列表和网格，并可按关键词筛选。\">\n    <div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><Button onClick={()=>setGrid(value=>!value)} /*__AW_PROPS_t0__*/ >{grid?'切换列表':'切换网格'}</Button><Field  /*__AW_PROPS_t1__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")} value={query} onChange={event=>setQuery(event.target.value)} /></Field></div><div data-ui=\"aw-business-grid\" className={cn(grid?'aw-business-grid':'aw-business-list')}>{visible.map(item=><article data-ui=\"aw-business-item\" key={item.id} className={cn(\"aw-business-item\")}><strong>{item.title}</strong><p>{item.category} · {item.quantity} 条记录</p></article>)}</div>{!visible.length?<p role=\"status\">没有匹配的工作项。</p>:null}\n  </BusinessDemo>;\n}\n",
