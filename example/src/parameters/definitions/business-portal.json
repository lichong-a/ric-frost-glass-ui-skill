  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { LocalPortal } from '../../components/LocalPortal';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessPortalDemo() {\n  const [visible,setVisible]=useState(false); const [target,setTarget]=useState<HTMLDivElement|null>(null); const [count,setCount]=useState(0);\n  return <BusinessDemo title=\"Portal\" description=\"将内容从源位置渲染到独立目标容器，目标切换后仍由React管理。\">\n    <div data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")}><p>内容来源区域</p><Button onClick={()=>setVisible(value=>!value)} /*__AW_PROPS_t0__*/ >{visible?'移除目标中的内容':'将内容渲染到目标'}</Button></div><div data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")} ref={setTarget} aria-label=\"Portal目标区域\"><h3>独立渲染目标</h3>{!visible?<p>目标中尚未挂载内容。</p>:null}</div>{visible?<LocalPortal target={target}><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><p>内容来自上方源区域，计数 {count}</p><Button  onClick={()=>setCount(value=>value+1)} /*__AW_PROPS_t2__*/ >增加计数</Button></div></LocalPortal>:null}\n  </BusinessDemo>;\n}\n",
