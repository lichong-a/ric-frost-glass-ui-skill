  "usageTemplate": "// Authored integration demo; implementation is installed from the pinned official source.\nimport Component from '../../../.upstream/src/ts-default/Components/MagicBento/MagicBento';\nimport { palette } from '../../shared/demo-support';\n\n// 上游没有items数据Props；本地集成转换更新固定示例文案与颜色，保留六个真实交互网格卡片。\n// 局部粒子、高光、边缘发光与倾斜效果保留；不把固定示例数据当成业务结果。\n\nexport default function MagicBentoDemo() {\n  const glow = [1, 3, 5].map(offset => parseInt(palette.primary.slice(offset, offset + 2), 16)).join(', ');\n  return (\n    <div className=\"aw-demo-stage\" style={{ width: '100%', minHeight: 580, position: 'relative', overflow: 'auto', padding: 20 }}>\n      <><style>{`.aw-demo-stage .magic-bento-card { color: var(--aw-color-text-primary); background-color: var(--aw-surface-panel) !important; border-color: var(--aw-color-border-divider) !important; }.aw-demo-stage .magic-bento-card__header,.aw-demo-stage .magic-bento-card__content,.aw-demo-stage .magic-bento-card__title { color: var(--aw-color-text-primary); }.aw-demo-stage .magic-bento-card__description,.aw-demo-stage .magic-bento-card__label { color: var(--aw-color-text-secondary); }`}</style><Component          glowColor={glow} /*__AW_PROPS_t0__*/  /></>\n    </div>\n  );\n}\n",
