  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { RangeSlider } from '../../components/RangeSlider';\nimport { useState, useId } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Field } from '../../components/Field';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\n// 场景：在有界连续范围内调整值或选择区间，保留精确值展示。\nexport default function SliderDemo() {\n  const id = useId(); const [value, setValue] = useState(/*__AW_STATE_state.value__*/); const [start, setStart] = useState(/*__AW_STATE_state.start__*/); const [end, setEnd] = useState(/*__AW_STATE_state.end__*/);\n  return <BusinessDemo title=\"Slider · 范围滑块\" description=\"单值和区间选择，同时展示精确数字。\"><Field  label={`采样比例 ${value}%`} htmlFor={id} /*__AW_PROPS_t0__*/ ><RangeSlider id={id}   value={value} onChange={event => setValue(Number(event.target.value))} /*__AW_PROPS_t1__*/  /></Field><Field  label={`区间下限 ${start}`} htmlFor={`${id}-start`} /*__AW_PROPS_t2__*/ ><RangeSlider id={`${id}-start`}  max={end} value={start} onChange={event => setStart(Number(event.target.value))} /*__AW_PROPS_t3__*/  /></Field><Field  label={`区间上限 ${end}`} htmlFor={`${id}-end`} /*__AW_PROPS_t4__*/ ><RangeSlider id={`${id}-end`} min={start}  value={end} onChange={event => setEnd(Number(event.target.value))} /*__AW_PROPS_t5__*/  /></Field><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">区间：{start}–{end}</p></BusinessDemo>;\n}\n",
