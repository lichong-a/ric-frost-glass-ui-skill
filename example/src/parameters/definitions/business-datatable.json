  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { SpringCheckbox } from '../../components/SpringCheckbox';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\nimport { workItems } from '../../data';\nimport { Pager } from '../../components/Pager';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessDataTableDemo() {\n  const [query,setQuery]=useState(/*__AW_STATE_state.query__*/);\n  const [sort,setSort]=useState<'title'|'quantity'>('title');\n  const [ascending,setAscending]=useState(true);\n  const [page,setPage]=useState(/*__AW_STATE_state.page__*/);\n  const [selected,setSelected]=useState<string[]>(/*__AW_STATE_state.selected__*/);\n  const filtered=workItems.filter(item=>item.title.includes(query)||item.category.includes(query)).sort((a,b)=>(sort==='title'?a.title.localeCompare(b.title,'zh-CN'):a.quantity-b.quantity)*(ascending?1:-1));\n  function order(field:'title'|'quantity'){setAscending(field===sort?!ascending:true);setSort(field);setPage(0);}\n  return <BusinessDemo title=\"DataTable\" description=\"在本地任务表中搜索、排序、勾选和分页；没有网络写入。\">\n    <Field  /*__AW_PROPS_t0__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")} value={query} onChange={event=>{setQuery(event.target.value);setPage(0);}} /></Field>\n    <div style={{overflowX:'auto'}}><table data-ui=\"aw-business-table\" className={cn(\"aw-business-table\")}><thead><tr><th scope=\"col\">选择</th><th scope=\"col\" aria-sort={sort==='title'?(ascending?'ascending':'descending'):'none'}><Button  onClick={()=>order('title')} /*__AW_PROPS_t2__*/ >任务 ↕</Button></th><th scope=\"col\">类别</th><th scope=\"col\" aria-sort={sort==='quantity'?(ascending?'ascending':'descending'):'none'}><Button  onClick={()=>order('quantity')} /*__AW_PROPS_t3__*/ >数量 ↕</Button></th></tr></thead><tbody>{filtered.slice(page*3,page*3+3).map(item=><tr key={item.id}><td><SpringCheckbox aria-label={'选择'+item.title} checked={selected.includes(item.id)} onChange={event=>setSelected(current=>event.target.checked?[...current,item.id]:current.filter(id=>id!==item.id))} /></td><td>{item.title}</td><td>{item.category}</td><td>{item.quantity}</td></tr>)}{!filtered.length?<tr><td colSpan={4}>没有符合条件的任务。</td></tr>:null}</tbody></table></div>\n    <Pager page={page}  total={filtered.length} onChange={setPage} /*__AW_PROPS_t5__*/  /><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">已选择 {selected.length} 项。</p>\n  </BusinessDemo>;\n}\n",
