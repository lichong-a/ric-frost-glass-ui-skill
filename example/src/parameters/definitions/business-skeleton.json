  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessSkeletonDemo() {\n  const [loading,setLoading]=useState(true);\n  return <BusinessDemo title=\"Skeleton\" description=\"展示内容准备中的占位结构，由明确按钮切换到本地实际内容。\">\n    <section data-ui=\"aw-business-item\" className={cn(\"aw-business-item\")} aria-busy={loading}>{loading?<div aria-hidden=\"true\" style={{display:'grid',gap:12}}><div data-ui=\"aw-business-skeleton\" className={cn(\"aw-business-skeleton\")} style={{height:28,width:'45%'}} /><div data-ui=\"aw-business-skeleton\" className={cn(\"aw-business-skeleton\")} style={{height:16,width:'100%'}} /><div data-ui=\"aw-business-skeleton\" className={cn(\"aw-business-skeleton\")} style={{height:16,width:'80%'}} /></div>:<><h3>资料整理任务</h3><p>本地内容已经可供阅读。</p></>}</section><p role=\"status\">{loading?'本地示例内容准备中。':'本地示例内容已显示。'}</p><Button  onClick={()=>setLoading(value=>!value)} /*__AW_PROPS_t0__*/ >{loading?'显示示例内容':'展示加载状态'}</Button>\n  </BusinessDemo>;\n}\n",
