  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport ownedStyles1 from '../../components/Input.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { Field } from '../../components/Field';\nimport { AnimatedSwap } from '../../components/AnimatedSwap';\n\nconst ownedStyles={...ownedStyles0,...ownedStyles1};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessInplaceDemo() {\n  const [editing,setEditing]=useState(/*__AW_STATE_state.editing__*/); const [value,setValue]=useState('资料整理'); const [draft,setDraft]=useState(value);\n  return <BusinessDemo title=\"Inplace\" description=\"点击名称就地编辑，保存校验非空，取消恢复此前值。\">\n    <AnimatedSwap value={editing?'editing':'reading'}>{editing?<form data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")} onSubmit={event=>{event.preventDefault();if(!draft.trim())return;setValue(draft.trim());setEditing(false);}}><Field  /*__AW_PROPS_t1__*/ ><input data-ui=\"aw-business-input\" className={cn(\"aw-business-input\")}  value={draft} onChange={event=>setDraft(event.target.value)} onKeyDown={event=>{if(event.key==='Escape')setEditing(false);}} /*__AW_PROPS_t2__*/  /></Field><Button  disabled={!draft.trim()} /*__AW_PROPS_t3__*/ >保存</Button><Button  onClick={()=>setEditing(false)} /*__AW_PROPS_t4__*/ >取消</Button></form>:<Button  onClick={()=>{setDraft(value);setEditing(true);}} /*__AW_PROPS_t5__*/ >{value} · 点击编辑</Button>}</AnimatedSwap>\n  </BusinessDemo>;\n}\n",
