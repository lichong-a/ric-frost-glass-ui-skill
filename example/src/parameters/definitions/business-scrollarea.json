  "usageTemplate": "import ownedStyles0 from '../../components/DemoLayout.module.css';\nimport { componentClasses } from '../../class-names';\nimport { useState, useRef } from 'react';\nimport { BusinessDemo } from '../../components/BusinessDemo';\nimport { Button } from '../../components/Button';\nimport { useBusinessReducedMotion } from '../../motion-preference';\n\nconst ownedStyles={...ownedStyles0};\nconst cn=(names:string)=>componentClasses(ownedStyles,names);\nexport default function BusinessScrollAreaDemo() {\n  const reduced=useBusinessReducedMotion(); const scroller=useRef<HTMLDivElement>(null); const [position,setPosition]=useState(0);\n  return <BusinessDemo title=\"ScrollArea\" description=\"在有限高度的资料区滚动，记录当前位置并可返回顶部。\">\n    <div data-ui=\"aw-business-item\" ref={scroller} className={cn(\"aw-business-item\")} style={{height:250,overflow:'auto'}} tabIndex={0} aria-label=\"可滚动资料列表\" onScroll={event=>setPosition(Math.round(event.currentTarget.scrollTop))}>{Array.from({length:16},(_,index)=><p key={index} style={{padding:12}}>第 {index+1} 条资料：保持内容、来源与结果有序。</p>)}</div><div data-ui=\"aw-business-row\" className={cn(\"aw-business-row\")}><Button  onClick={()=>scroller.current?.scrollTo({top:0,behavior:reduced?'auto':'smooth'})} /*__AW_PROPS_t0__*/ >回到顶部</Button><p data-ui=\"aw-business-status\" className={cn(\"aw-business-status\")} role=\"status\">已滚动 {position}px</p></div>\n  </BusinessDemo>;\n}\n",
